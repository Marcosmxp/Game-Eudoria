{
  "schemaVersion": 2,
  "id": "eudoria.ui.hud",
  "legacyStage": {
    "width": 1200,
    "height": 640
  },
  "scaling": {
    "mode": "anchored",
    "pixelPerfectLegacyMode": true
  },
  "layers": [
    "world",
    "worldEffects",
    "hud",
    "windows",
    "modal",
    "tooltip",
    "cursor"
  ],
  "components": [
    {
      "id": "playerInfo",
      "legacySymbol": "playerUI.PlayerInfoUIMC",
      "legacyExport": "symbol3550",
      "characterId": 3550,
      "root": { "x": 0, "y": 0 },
      "anchor": "top-left"
    },
    {
      "id": "gameInfo",
      "legacySymbol": "playerUI.GameInfoUIMC",
      "legacyExport": "symbol4343",
      "characterId": 4343,
      "root": { "x": 0, "y": 570 },
      "anchor": "bottom-left",
      "notes": "GameInfoUI sets y = stageHeight - 70. This is the chat/message HUD visible at bottom-left."
    },
    {
      "id": "controlBar",
      "legacySymbol": "playerUI.ControlBarUIMC",
      "legacyExport": "symbol4131",
      "characterId": 4131,
      "root": { "x": 600, "y": 640 },
      "anchor": "bottom-center",
      "notes": "ControlBarUI sets x = stageWidth / 2 and y = stageHeight."
    },
    {
      "id": "smallMap",
      "legacySymbol": "playerUI.SmallMapUIMC",
      "legacyExport": "symbol1825",
      "characterId": 1825,
      "root": { "x": 1200, "y": 0 },
      "anchor": "top-right",
      "contentSource": "img.rar",
      "notes": "SmallMapUI sets x = stageWidth. The minimap image content comes from img.rar; this symbol is the minimap HUD/frame and controls."
    },
    {
      "id": "taskTracer",
      "legacySymbol": "playerUI.TaskTracerUIMC",
      "legacyExport": "symbol4135",
      "characterId": 4135,
      "root": { "x": 960, "y": 230 },
      "anchor": "top-right",
      "notes": "TaskTracerUI sets x = stageWidth - titleBox.width and y = 230. titleBox is 240px wide in the legacy display list."
    }
  ],
  "windows": {
    "worldMap": "playerUI.WorldMapUIMC",
    "character": "playerUI.PlayerFullInfoUIMC",
    "inventory": "playerUI.MainBagUIMC",
    "achievements": "playerUI.AchievementUIMC",
    "skills": "playerUI.SkillBookUIMC",
    "mount": "playerUI.RideBoxUIMC",
    "friends": "playerUI.FriendBoxUIMC",
    "pet": "playerUI.PetBoxUIMC",
    "quests": "playerUI.TaskBoxUIMC",
    "afk": "playerUI.BotUIMC"
  }
}
